{
  "name": "ai-gateway-route-studio",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  // 关键：保留 Dashboard 里设置的变量（否则每次部署会删掉 wrangler.jsonc 里没有的 Text 变量）
  // Secret 类型不受部署影响，无需此开关也不会丢
  "keep_vars": true,
  // 静态资源目录：/ 返回 index.html，/login.html 登录页，/assets/* 静态文件
  // run_worker_first=true：所有请求先过 Worker（登录门），通过后转发给静态资源
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // 账户 ID（非敏感，网关调用 URL 里本来就含此 ID；私有仓库无风险）
  // 写死后 Dashboard 里无需再配 ACCOUNT_ID，部署也不会再被覆盖
  "vars": {
    "ACCOUNT_ID": "d2fee57c34c53ed8eb799795cd106648"
  }
  // 敏感信息用 secret（不要写在这里）。两种配置方式任选：
  //   GitHub 部署：Dashboard → 该 Worker → Settings → Variables and Secrets → Add（类型必须选 Secret）
  //   CLI 部署：wrangler secret put ADMIN_TOKEN / CF_API_TOKEN / OPENAI_API_KEY 等
}
